# Kopiera till .env.local och fyll i. På Vercel läggs samma värden in under Environment Variables.

# Sajtens riktiga adress – används i sitemap, canonical-länkar och strukturerad data
NEXT_PUBLIC_SITE_URL=https://smartstyra.se

# Vem som driver sajten – visas på Om- och Integritetssidan om den är ifylld
NEXT_PUBLIC_OWNER_NAME=

# Kontaktformuläret (/kontakt) och nyhetsbrevet skickar via Resend (resend.com). Adressen i
# CONTACT_TO visas aldrig på sajten. Med standardavsändaren onboarding@resend.dev går det bara att
# skicka till samma e-post som Resend-kontot är registrerat på.
RESEND_API_KEY=
CONTACT_TO=
# Valfritt, kräver att domänen är verifierad hos Resend, t.ex. "Smartstyra <kontakt@smartstyra.se>"
CONTACT_FROM=

# Valfritt: id för en Audience hos Resend. Är den ifylld läggs nya prenumeranter in där.
# Annars skickas varje ny prenumerant som ett mejl till CONTACT_TO.
RESEND_AUDIENCE_ID=
